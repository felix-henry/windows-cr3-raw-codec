#include <winresrc.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CR3_VER_MAJOR,CR3_VER_MINOR,CR3_VER_PATCH,0
 PRODUCTVERSION CR3_VER_MAJOR,CR3_VER_MINOR,CR3_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CR3 WIC Codec Project"
            VALUE "FileDescription", "Canon CR3 Native WIC RAW Decoder (LibRaw)"
            VALUE "FileVersion", CR3_VER_STR_A
            VALUE "InternalName", "CR3WICCodec.dll"
            VALUE "OriginalFilename", "CR3WICCodec.dll"
            VALUE "ProductName", "Canon CR3 WIC Codec"
            VALUE "ProductVersion", CR3_VER_STR_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
