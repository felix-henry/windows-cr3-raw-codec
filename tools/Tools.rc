#include <winresrc.h>
#include "../src/Version.h"

#ifndef CR3_TOOL_DESC
#define CR3_TOOL_DESC "Canon CR3 WIC RAW Codec Utility"
#endif
#ifndef CR3_TOOL_FILENAME
#define CR3_TOOL_FILENAME "CR3WICCodecTool.exe"
#endif
#ifndef CR3_TOOL_INTERNAL
#define CR3_TOOL_INTERNAL "CR3WICCodecTool"
#endif

1 ICON "../assets/CR3WICCodec.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CR3_VER_MAJOR,CR3_VER_MINOR,CR3_VER_PATCH,0
 PRODUCTVERSION CR3_VER_MAJOR,CR3_VER_MINOR,CR3_VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CR3 WIC Codec Project"
            VALUE "FileDescription", CR3_TOOL_DESC
            VALUE "FileVersion", CR3_VER_STR_A
            VALUE "InternalName", CR3_TOOL_INTERNAL
            VALUE "OriginalFilename", CR3_TOOL_FILENAME
            VALUE "ProductName", "Canon CR3 WIC Codec"
            VALUE "ProductVersion", CR3_VER_STR_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
